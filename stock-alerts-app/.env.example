# Copie ce fichier en .env puis renseigne les valeurs

PORT=3737

# Genere ces clefs avec : npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:toi@example.com

# Intervalles de rafraichissement (minutes)
PRICE_INTERVAL_MINUTES=5
NEWS_INTERVAL_MINUTES=10

# Seuil de variation (%) par defaut pour les alertes de cours
DEFAULT_MOVE_PERCENT=3

# Projet Supabase dedie (etat partage entre le tableau de bord local et le
# workflow GitHub Actions). Voir le README pour les valeurs a utiliser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
